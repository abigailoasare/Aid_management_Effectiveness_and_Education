      dm_comp_ieg_edu_ls     = ifelse(comp_ieg_edu_ls > 0, 1, 0),
      dbxr2011_comp_edu1     = log(0.01 + dbxr2011_comp_edu),
      dbxr2011_comp_ieg_edu_hs1 = log(0.01 + dbxr2011_comp_ieg_edu_hs),
      dbxr2011_comp_ieg_edu_ms1 = log(0.01 + dbxr2011_comp_ieg_edu_ms),
      dbxr2011_comp_ieg_edu_ls1 = log(0.01 + dbxr2011_comp_ieg_edu_ls),
      gpw_sum                = gpw_ip_sum / 100000,
      shr_neversch_6_24      = shr_neversch_6_24 * 100,
      GID_2                  = ifelse(is.na(GID_2), iso2code, GID_2)
    )
  
  # Define the estimation sample 
  reg_obs <- feols(
    shr_neversch_6_24 ~  dbxr2011_comp_edu1 +
      conflict_5y_n + I(conflict_5y_n == 0) +
      gpw_sum + sol_mean + pre_mean + tmp_mean + spei_mean +
      av_age_mm + av_age_head + av_size_hh + shr_son_daughter
    | DHSYEAR + GID_2,
    data = reg_df
  )
  
  # Now the three models on the same sample
  reg_ind1 <- feols(
    shr_neversch_6_24 ~  dbxr2011_comp_edu1 +
      conflict_5y_n + I(conflict_5y_n == 0) +
      gpw_sum + sol_mean + pre_mean + tmp_mean + spei_mean +
      av_age_mm + av_age_head + av_size_hh + shr_son_daughter
    | DHSYEAR + GID_2,
    data   = reg_df,
    subset = obs(reg_obs)
  )
  
  reg_ind2 <- feols(
    shr_neversch_6_24 ~ dbxr2011_comp_ieg_edu_hs1 +
      dbxr2011_comp_ieg_edu_ms1 + dbxr2011_comp_ieg_edu_ls1 + 
      conflict_5y_n + I(conflict_5y_n == 0) +
      gpw_sum + sol_mean + pre_mean + tmp_mean + spei_mean +
      av_age_mm + av_age_head + av_size_hh + shr_son_daughter
    | DHSYEAR + GID_2,
    data   = reg_df,
    subset = obs(reg_obs)
  )
  
  # Extract coefs (clustered) and keep only terms you care about
  keep_terms <- names(var_names)
  
  out <- rbindlist(list(
    extract_coefs(reg_ind1, distance, "Edu. aid dummy"),
    extract_coefs(reg_ind2, distance, "Management Rating")
  ), use.names = TRUE, fill = TRUE)
  
  out <- out[term %in% keep_terms]
  out[, term_label := unname(var_names[term])]
  out[]
}


