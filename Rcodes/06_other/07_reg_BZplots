# Functions to extract coefficients -----------------------------------------
extract_coefs <- function(model, distance, model_name, cluster_fml = ~DHSID) {
  ct <- as.data.frame(summary(model, cluster = cluster_fml)$coeftable)
  ct$term <- rownames(ct)
  rownames(ct) <- NULL
  
  # Standardize column names from fixest coeftable
  # Estimate, Std. Error, t value, Pr(>|t|)
  setDT(ct)
  setnames(ct,
           old = intersect(names(ct), c("Estimate", "Std. Error", "Pr(>|t|)")),
           new = c("estimate", "std_error", "p_value")[1:length(intersect(names(ct), c("Estimate", "Std. Error", "Pr(>|t|)")))]
  )
  
  # If fixest uses different naming (rare), fallback:
  if (!("estimate" %in% names(ct))) ct[, estimate := get(names(ct)[1])]
  if (!("std_error" %in% names(ct))) ct[, std_error := get(names(ct)[2])]
  
  ct[, `:=`(
    distance = distance,
    model    = model_name,
    conf_low = estimate - 1.96 * std_error,
    conf_high= estimate + 1.96 * std_error
  )]
  ct[]
}

